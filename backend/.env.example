# ─── Application ───────────────────────────────────────────────────────────
APP_NAME="InsureClaim AI"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=insurance_claims
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/insurance_claims

# ─── MongoDB ────────────────────────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=insurance_claims_docs
MONGO_USER=
MONGO_PASSWORD=
MONGO_URL=mongodb://localhost:27017

# ─── AES-256 Encryption ─────────────────────────────────────────────────────
# Must be exactly 32 bytes (256-bit), base64-encoded
AES_ENCRYPTION_KEY=your-aes-256-key-exactly-32-bytes==

# ─── AI Services ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ─── File Uploads ───────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Monitoring ─────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
